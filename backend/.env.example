# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# ── IBM watsonx.ai credentials ────────────────────────────────────────────────
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Model selection ───────────────────────────────────────────────────────────
# Default: ibm/granite-3-8b-instruct  (current Granite instruct model)
# Other options: ibm/granite-3-2b-instruct  ibm/granite-13b-instruct-v2
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Engine toggle ─────────────────────────────────────────────────────────────
# Set to false to enable watsonx.ai (requires credentials above)
# Set to true to force local mock analysis regardless of credentials
USE_MOCK_AI=false
